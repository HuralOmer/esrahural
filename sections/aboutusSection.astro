---

<section class="aboutus-section" id="aboutus">
  <img class="aboutus-section__decor aboutus-section__decor--girl" src={aboutGirl.src} alt="" aria-hidden="true" />

  <div class="aboutus-section__inner">
    <div class="aboutus-section__media" aria-label="Anaokulu etkinlik görselleri">
      <div class="aboutus-section__clip-frame">
        <svg class="aboutus-section__clip" viewBox="0 0 595.28 600" role="img" aria-label="Çocuk eğitiminden iki fotoğraf">
          <defs>
            <clipPath id="aboutusBigClip">
              <path d={bigClipPath}></path>
            </clipPath>
            <clipPath id="aboutusSmallClip">
              <path d={smallClipPath}></path>
            </clipPath>
          </defs>

          <image
            href={aboutImg1.src}
            x="42"
            y="68"
            width="455"
            height="390"
            preserveAspectRatio="xMidYMid slice"
            clip-path="url(#aboutusBigClip)"
          />

          <image
            href={aboutImg2.src}
            x="328"
            y="314"
            width="205"
            height="178"
            preserveAspectRatio="xMidYMid slice"
            clip-path="url(#aboutusSmallClip)"
          />
        </svg>

        <img class="aboutus-section__clip-overlay" src={aboutClipOverlay.src} alt="" aria-hidden="true" />
      </div>
    </div>

    <img class="aboutus-section__decor aboutus-section__decor--car" src={aboutCar.src} alt="" aria-hidden="true" />

    <div class="aboutus-section__content">
      <p class="aboutus-section__eyebrow">Hakkımızda</p>
      <h2 class="aboutus-section__title">Çocuklar İçin En İyi Seçim</h2>
      <p class="aboutus-section__text">
        Çocukların merakını, yaratıcılığını ve güven duygusunu destekleyen sıcak bir öğrenme ortamı sunuyoruz.
        Her yaş grubuna özel programlarımızla gelişimi keyifli hale getiriyoruz.
      </p>

      <div class="aboutus-section__features" aria-label="Öne çıkan özellikler">
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12 3 3 7-7"></path><circle cx="12" cy="12" r="9"></circle></svg>Oyunla Öğrenme</span>
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12 3 3 7-7"></path><circle cx="12" cy="12" r="9"></circle></svg>Yaratıcı Atölyeler</span>
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12 3 3 7-7"></path><circle cx="12" cy="12" r="9"></circle></svg>Güvenli Alan</span>
        <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12 3 3 7-7"></path><circle cx="12" cy="12" r="9"></circle></svg>Uzman Eğitmenler</span>
      </div>

      <div class="aboutus-section__actions">
        <a class="aboutus-section__button" href="/hakkimizda">
          Daha Fazla
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>

      </div>
    </div>
  </div>

  <img class="aboutus-section__bottom-wave" src={aboutBottomWave.src} alt="" aria-hidden="true" />
</section>
