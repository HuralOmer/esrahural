---
import "../style/headerTopStyle.css";
---

<section class="header-top-section" aria-label="Ust bilgi">
  <div class="header-top-section__inner">
    <div class="header-top-section__contact">
      <a class="header-top-section__link" href="https://maps.google.com/?q=6391+Elgin+St.+Celina,+USA" target="_blank" rel="noreferrer">
        <svg class="header-top-section__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>6391 Elgin St. Celina, ABD</span>
      </a>

      <a class="header-top-section__link" href="mailto:info@example.com">
        <svg class="header-top-section__icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
        <span>info@example.com</span>
      </a>
    </div>

    <div class="header-top-section__social" aria-label="Sosyal medya">
      <span class="header-top-section__follow">Bizi Takip Edin:</span>
      <a class="header-top-section__social-link" href="#" aria-label="Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 8h2.5V4.5A17 17 0 0 0 14.2 4C10.9 4 9 6 9 9.5V12H6v4h3v8h4v-8h3.2l.6-4H13V9.9C13 8.7 13.4 8 15 8Z"></path>
        </svg>
        <span class="header-top-section__social-label">Facebook</span>
      </a>
      <a class="header-top-section__social-link" href="#" aria-label="Twitter">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22 5.8c-.7.3-1.5.6-2.4.7.9-.5 1.5-1.3 1.8-2.3-.8.5-1.7.8-2.7 1A4.1 4.1 0 0 0 11.6 9c0 .3 0 .6.1.9A11.7 11.7 0 0 1 3.2 5.6a4.1 4.1 0 0 0 1.3 5.5c-.7 0-1.3-.2-1.9-.5v.1c0 2 1.4 3.6 3.3 4-.3.1-.7.1-1.1.1-.3 0-.5 0-.8-.1.5 1.7 2.1 2.9 3.9 2.9A8.3 8.3 0 0 1 2 19.2a11.7 11.7 0 0 0 6.3 1.8c7.5 0 11.7-6.2 11.7-11.7v-.5c.8-.6 1.5-1.3 2-2.1Z"></path>
        </svg>
        <span class="header-top-section__social-label">Twitter</span>
      </a>
      <a class="header-top-section__social-link" href="#" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.9 8.8H3.2V21h3.7V8.8ZM5.1 7.1a2.1 2.1 0 1 0 0-4.2 2.1 2.1 0 0 0 0 4.2ZM21 14.2c0-3.5-1.9-5.7-4.8-5.7-1.9 0-3.1 1-3.7 2V8.8H8.9V21h3.7v-6.1c0-1.7.9-2.9 2.4-2.9s2.3 1.1 2.3 3V21H21v-6.8Z"></path>
        </svg>
        <span class="header-top-section__social-label">LinkedIn</span>
      </a>
      <a class="header-top-section__social-link" href="#" aria-label="YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21.6 7.2a3 3 0 0 0-2.1-2.1C17.6 4.6 12 4.6 12 4.6s-5.6 0-7.5.5a3 3 0 0 0-2.1 2.1C2 9.1 2 12 2 12s0 2.9.4 4.8a3 3 0 0 0 2.1 2.1c1.9.5 7.5.5 7.5.5s5.6 0 7.5-.5a3 3 0 0 0 2.1-2.1c.4-1.9.4-4.8.4-4.8s0-2.9-.4-4.8ZM10 15.4V8.6l6 3.4-6 3.4Z"></path>
        </svg>
        <span class="header-top-section__social-label">YouTube</span>
      </a>
    </div>
  </div>
</section>
