---
import "../style/whyYouStyle.css";
import cardImage from "../assets/whyYouAsset/whyYouCardImage.jpg";
import figureLeft from "../assets/whyYouAsset/whyYouFigureLeft.png";
import figureRight from "../assets/whyYouAsset/whyYouFigureRight.png";

const cardBodyPath =
  "M116.76,1.81c16.15-1.1,33.52-1.7,51.96-1.53,16.98.15,33.02.93,48.03,2.13,6.84.43,16.87,1.86,28.07,6.46,10.01,4.11,17.49,9.33,22.5,13.43,3.79,3.05,9.11,7.67,14.82,13.9,5.48,5.97,15.15,17.58,25.47,39.66,14.96,31.98,21.7,65.41,24.48,81.67,1.22,8.98,2.1,18.48,2.5,28.46,1.78,44.24-6.45,82.3-16.17,111.49-2.48,7.13-6.23,16.63-11.83,27.32-5.26,10.04-14.11,26.65-30.89,43.49-7.43,7.46-18.73,17.29-34.52,26.18-16.37,6.61-37.82,13.45-63.53,17.14-36.48,5.24-67.4,2.13-88.75-1.8-9.06-1.91-22.9-6.04-37.25-15.69-9.48-6.38-16.43-13.31-21.27-18.97-6.43-8.4-14.97-21.53-21.03-39.27-5.66-16.57-7.14-31.2-7.38-41.42-.62-9.08-1.09-18.34-1.38-27.78-1.5-48.95,1.97-94.29,8.19-135.29,1.88-13.03,5.27-28.78,11.5-46.02,4.69-12.98,10.04-24.17,15.21-33.53,4.24-7.76,12.02-19.4,25.09-29.61C83.06,4.68,107.14,2.25,116.76,1.81Z";

const cardImageClipPath =
  "M64.55,34.23c5.19-4,12.88-9.01,23.04-12.86,11.66-4.41,22.02-5.56,29.04-5.78,16.08-.47,32.64-.7,49.66-.64,18.28.07,36.04.47,53.23,1.15,8.4,1.1,22.6,4.04,37.79,13.02,14.6,8.63,23.82,19.11,28.85,25.79,4.59,6.14,10.39,15.27,14.81,27.32,4.54,12.39,5.97,23.38,6.38,31.15-.05,7.62-.86,17.69-3.83,29.11-2.94,11.31-7.09,20.41-10.72,27.06-5.61,8.69-15.78,22.01-32.43,33.45-12.31,8.46-24.07,13.08-32.68,15.68-15.33,3.62-33.06,6.79-52.85,8.57-24.74,2.23-46.87,1.77-65.49.21-9.06-.22-35.27-2.06-56.81-21.06-4.28-3.77-13.55-12.14-19.74-26.55-4.85-11.3-5.73-21.47-5.79-27.66.28-18.31,1.99-38.43,6-59.87.97-5.21,2.04-10.27,3.19-15.19,1.51-6.08,4.58-15.34,11.23-25.02,5.87-8.56,12.38-14.31,17.11-17.87Z";

const cards = [
  {
    variant: "teal",
    title: "Kendini yalnız hissedenler",
    text: "Bu yükü tek başına taşımaya çalışan herkes için.",
  },
  {
    variant: "orange",
    title: "Zorlanan ebeveynler",
    text: "Çocuğuyla daha sakin ve güvenli bağ kurmak isteyenler için.",
  },
  {
    variant: "white",
    title: "Cevap arayanlar",
    text: "Nereden başlayacağını bilemeyen ama değişim isteyenler için.",
  },
  {
    variant: "orange",
    title: "Kaygısı artanlar",
    text: "Günlük hayatın içinde nefes alacak alan arayanlar için.",
  },
  {
    variant: "white",
    title: "Destek isteyenler",
    text: "Anlaşılmak, duyulmak ve yanında biri olsun isteyenler için.",
  },
  {
    variant: "teal",
    title: "Yeni bir yol arayanlar",
    text: "Daha iyi hissetmek için küçük ama gerçek adımlar atanlar için.",
  },
];
---

<section class="why-you-section" id="why-you" aria-labelledby="why-you-title">
  <img class="why-you-section__figure why-you-section__figure--left" src={figureLeft.src} alt="" aria-hidden="true" />
  <img class="why-you-section__figure why-you-section__figure--right" src={figureRight.src} alt="" aria-hidden="true" />

  <div class="why-you-section__inner">
    <div class="why-you-section__heading">
      <p class="why-you-section__eyebrow">Kimler için?</p>
      <h2 id="why-you-title" class="why-you-section__title">Yalnız değilsiniz</h2>
      <p class="why-you-section__text">
        "Neden bu kadar zor?" diye soruyorsanız, muhtemelen doğru yerdesiniz.
      </p>
    </div>

    <div class="why-you-section__grid" aria-label="Kimler için kartları">
      {
        cards.map((card, index) => (
          <article class={`why-you-section__card why-you-section__card--${card.variant}`}>
            <svg class="why-you-section__card-art" viewBox="0 0 335.09 414.62" aria-hidden="true">
              <defs>
                <clipPath id={`why-you-card-image-${index}`}>
                  <path d={cardImageClipPath}></path>
                </clipPath>
              </defs>
              <path class="why-you-section__card-body" d={cardBodyPath}></path>
              <image
                class="why-you-section__card-photo"
                href={cardImage.src}
                x="27"
                y="15"
                width="281"
                height="214"
                preserveAspectRatio="xMidYMid slice"
                clip-path={`url(#why-you-card-image-${index})`}
              />
            </svg>

            <div class="why-you-section__card-content">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>

            <a class="why-you-section__card-button" href="/iletisim" aria-label={`${card.title} hakkında bilgi al`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
